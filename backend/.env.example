# ==============================================================================
# CONFIGURATION ENVIRONNEMENT BACKEND (Render + Aiven)
# ==============================================================================

# Port d'écoute du serveur (Render l'injecte automatiquement en production)
PORT=5000

# Environnement (production sur Render, development en local)
NODE_ENV=production

# ------------------------------------------------------------------------------
# BASE DE DONNÉES AIVEN (MYSQL)
# Deux options possibles sur Render :
# ------------------------------------------------------------------------------

# OPTION 1 : Service URI complète fournie par Aiven (RECOMMANDÉ)
# Copiez directement la "Service URI" depuis la console Aiven :
# DATABASE_URL=mysql://avnadmin:VOTRE_MOT_DE_PASSE@mysql-xxxx-yyyy.aivencloud.com:25060/defaultdb?ssl-mode=REQUIRED

# OPTION 2 : Variables individuelles Aiven
DB_HOST=mysql-xxxx-yyyy.aivencloud.com
DB_PORT=25060
DB_USER=avnadmin
DB_PASSWORD=VOTRE_MOT_DE_PASSE_AIVEN
DB_NAME=defaultdb
DB_SSL=true

# ------------------------------------------------------------------------------
# SÉCURITÉ & AUTHENTIFICATION
# ------------------------------------------------------------------------------
# Clé secrète robuste pour signer les tokens JWT (Générez une chaîne aléatoire de 64 caractères)
JWT_SECRET=generer_une_cle_secrete_ultra_robuste_ici

# Identifiants de l'administrateur initial pour le script seed (npm run seed)
ADMIN_EMAIL=admin@portfolio.com
ADMIN_PASSWORD=VotreMotDePasseAdminSecurise123!

# ------------------------------------------------------------------------------
# CORS (COMMUNICATION AVEC VERCEL)
# ------------------------------------------------------------------------------
# URL(s) de votre frontend Vercel (séparées par une virgule si plusieurs)
# Note : les déploiements de preview Vercel (*.vercel.app) sont autorisés automatiquement.
FRONTEND_URL=https://votre-portfolio.vercel.app,http://localhost:3000
